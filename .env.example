# Copia a .env y completa. .env está en .gitignore, nunca lo subas a GitHub.

# Obligatorio: firma las cookies de sesión del dashboard (login). Cualquier
# string largo al azar sirve, ej. `python -c "import secrets; print(secrets.token_hex(32))"`.
FLASK_SECRET_KEY=

# Estos cuatro ya NO se leen en cada corrida — son por usuario, se cargan
# desde /configuracion en el dashboard (ver src/db.py, tabla `usuarios`).
# Solo se usan acá como valores de partida para la cuenta que crees con
# `migrar-a-multiusuario` (si vienes de una instalación de una sola persona).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Solo si vas a usar el portal "correo" (alertas de Laborum/LinkedIn/Indeed
# por email). Contraseña de aplicación de Google, no tu contraseña normal:
# Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de
# aplicaciones. Ver src/scrapers/correo.py.
GMAIL_USER=
GMAIL_APP_PASSWORD=
